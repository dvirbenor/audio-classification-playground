name: "affect"
backend: "onnxruntime"

# Maximum batch Triton will dispatch to the ONNX model in one shot.
# Restored to 256 (production target). Memory is kept in check not by capping
# the batch but by taming ONNX Runtime's allocator (see the optimization block):
# mem_pattern off + a single fixed batch shape + HEURISTIC conv search, so ORT
# sits near its true ~15 GiB working set instead of ballooning to ~85 GiB.
max_batch_size: 256

dynamic_batching {
  # Single preferred size → bias the batcher toward uniform 256-window batches,
  # minimising the number of distinct input shapes ORT's arena has to retain.
  preferred_batch_size: [256]
  # 10 ms — enough to accumulate requests from several concurrent workers
  # without adding perceptible latency to the per-archive pipeline.
  max_queue_delay_microseconds: 10000
}

# Input: one pre-segmented audio window, 3.5 s × 16 kHz = 56 000 samples.
# Batch dimension is implicit (controlled by max_batch_size above).
input [
  {
    name: "input_values"
    data_type: TYPE_FP32
    dims: [56000]
  }
]

# Outputs match WavLMWrapper.forward() -> (arousal, valence, dominance),
# each shape [batch, 1] in the ONNX graph.
output [
  {
    name: "arousal"
    data_type: TYPE_FP32
    dims: [1]
  },
  {
    name: "valence"
    data_type: TYPE_FP32
    dims: [1]
  },
  {
    name: "dominance"
    data_type: TYPE_FP32
    dims: [1]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
    gpus: [0]
  }
]

# Use the FP16 model produced by export_models_onnx.py (_fp16.onnx variant).
# ONNX Runtime's CUDA EP applies mixed precision automatically — numerically
# sensitive ops (attention softmax, LayerNorm) stay in FP32, everything else
# runs on FP16 tensor cores. This is NOT the TensorRT path that caused NaNs;
# ONNX Runtime doesn't cast indiscriminately.
# Input/output types remain FP32 (keep_io_types=True at conversion) so neither
# the Triton config nor the client predictors need to change.

# --- Tame ONNX Runtime's GPU memory so all three fit at batch 256 -----------
# ONNX/ORT used ~85 GiB for one batch-256 WavLM forward vs ~15 GiB for the same
# model in PyTorch (the MPS path) — a serving-allocator problem, not the model.
# The CUDA BFC arena never releases memory and fragments across the *varying*
# batch shapes the dynamic batcher produces; mem_pattern pre-allocates a big
# buffer per shape; and EXHAUSTIVE conv search grabs large workspaces the arena
# then keeps. gpu_mem_limit / arena_extend_strategy are NOT honored by this
# backend (25.05) — verified in the verbose startup log — so instead we make ORT
# behave like the static PyTorch path:
#   * enable_mem_pattern 0 (session option, below) — no per-shape pre-allocation.
#   * single preferred_batch_size 256 (above) — minimise distinct input shapes.
#   * cudnn_conv_algo_search HEURISTIC — skip EXHAUSTIVE's workspace-hungry
#       search (also removes a slow-first-inference prod anti-pattern).
#   * cudnn_conv_use_max_workspace 0 — cap the conv workspace (honored).
#   * arena_extend_strategy 1 — kSameAsRequested retry (harmless if still ignored).
# Confirm in the log: Session Options should show enable_mem_pattern:0, and the
# CUDA EP line cudnn_conv_algo_search=HEURISTIC.
optimization {
  execution_accelerators {
    gpu_execution_accelerator [
      {
        name: "cuda"
        parameters { key: "cudnn_conv_use_max_workspace" value: "0" }
        parameters { key: "cudnn_conv_algo_search" value: "HEURISTIC" }
        parameters { key: "arena_extend_strategy" value: "1" }
      }
    ]
  }
}

parameters {
  key: "enable_mem_pattern"
  value: { string_value: "0" }
}
