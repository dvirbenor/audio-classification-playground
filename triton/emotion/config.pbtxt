name: "emotion"
backend: "onnxruntime"

# emotion2vec_plus_large, exported as a pure-ONNX model by
# scripts/export_models_onnx.py (DirectEmotion2vecScorer.core: layer-norm +
# extract_features + mean-pool + proj + masked softmax + label select).
# Batch 256 (production target); memory tamed via the optimization block, not by
# capping the batch — see triton/affect/config.pbtxt.
max_batch_size: 256

dynamic_batching {
  preferred_batch_size: [256]
  # Slightly longer delay for emotion — it's less latency-sensitive, so a wider
  # window to accumulate a larger batch is a good trade.
  max_queue_delay_microseconds: 20000
}

# Input: one pre-segmented audio window, 3.0 s × 16 kHz = 48 000 samples.
input [
  {
    name: "input_values"
    data_type: TYPE_FP32
    dims: [48000]
  }
]

# Output: raw per-class softmax scores over the 9 native emotion2vec labels,
# in EMOTION2VEC_LABELS order (see inference/emotion2vec.py). The client
# (TritonEmotionPredictor) pairs these with EMOTION2VEC_LABELS and the producer's
# emotion2vec_scores_to_probabilities() folds them into the 8 CANONICAL_CHANNELS
# ("<unk>" + "其他/other" -> "other"). Canonicalization is intentionally NOT in
# the graph, matching the direct (non-Triton) fleet path.
output [
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [9]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
    gpus: [0]
  }
]

# FP16 weights (Conv kept FP32 by the exporter) run on FP16 tensor cores via the
# ONNX Runtime CUDA EP — same approach as affect/disfluency.

# --- Tame ONNX Runtime's GPU memory (mem_pattern off + HEURISTIC + single batch
# shape) so all three models fit at batch 256. See triton/affect/config.pbtxt
# for the full rationale. cudnn_conv_use_max_workspace 0 also fixes emotion's
# Conv-node OOM.
optimization {
  execution_accelerators {
    gpu_execution_accelerator [
      {
        name: "cuda"
        parameters { key: "cudnn_conv_use_max_workspace" value: "0" }
        parameters { key: "cudnn_conv_algo_search" value: "HEURISTIC" }
        parameters { key: "arena_extend_strategy" value: "1" }
      }
    ]
  }
}

parameters {
  key: "enable_mem_pattern"
  value: { string_value: "0" }
}
