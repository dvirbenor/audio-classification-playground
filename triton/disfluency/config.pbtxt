name: "disfluency"
backend: "onnxruntime"

# Batch 256 (production target); memory tamed via the optimization block, not by
# capping the batch — see triton/affect/config.pbtxt.
max_batch_size: 256

dynamic_batching {
  preferred_batch_size: [256]
  max_queue_delay_microseconds: 10000
}

# Input: one pre-segmented audio window, 3.0 s × 16 kHz = 48 000 samples.
input [
  {
    name: "input_values"
    data_type: TYPE_FP32
    dims: [48000]
  }
]

# Outputs match _DisfluencyWrapper.forward() -> (fluency_logits, disfluency_type_logits).
output [
  {
    name: "fluency_logits"
    data_type: TYPE_FP32
    dims: [2]
  },
  {
    name: "disfluency_type_logits"
    data_type: TYPE_FP32
    dims: [5]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
    gpus: [0]
  }
]

# --- Tame ONNX Runtime's GPU memory (mem_pattern off + HEURISTIC + single batch
# shape) so all three models fit at batch 256. See triton/affect/config.pbtxt
# for the full rationale; gpu_mem_limit / arena_extend_strategy are ignored by
# this backend, so we shape ORT's allocator behaviour instead.
optimization {
  execution_accelerators {
    gpu_execution_accelerator [
      {
        name: "cuda"
        parameters { key: "cudnn_conv_use_max_workspace" value: "0" }
        parameters { key: "cudnn_conv_algo_search" value: "HEURISTIC" }
        parameters { key: "arena_extend_strategy" value: "1" }
      }
    ]
  }
}

parameters {
  key: "enable_mem_pattern"
  value: { string_value: "0" }
}

