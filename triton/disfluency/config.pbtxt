name: "disfluency"
backend: "onnxruntime"

max_batch_size: 256

dynamic_batching {
  preferred_batch_size: [128, 256]
  max_queue_delay_microseconds: 10000
}

# Input: one pre-segmented audio window, 3.0 s × 16 kHz = 48 000 samples.
input [
  {
    name: "input_values"
    data_type: TYPE_FP32
    dims: [48000]
  }
]

# Outputs match _DisfluencyWrapper.forward() -> (fluency_logits, disfluency_type_logits).
output [
  {
    name: "fluency_logits"
    data_type: TYPE_FP32
    dims: [2]
  },
  {
    name: "disfluency_type_logits"
    data_type: TYPE_FP32
    dims: [5]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
    gpus: [0]
  }
]

# --- GPU memory fairness ---------------------------------------------------
# Per-model ONNX Runtime CUDA arena cap so the three co-hosted models coexist
# on the shared 96 GiB GPU instead of the first WavLM model grabbing it all.
# See triton/affect/config.pbtxt for the full rationale (memory analog of the
# MPS per-client SM cap). 28 GiB (48 000-sample window).
optimization {
  execution_accelerators {
    gpu_execution_accelerator [
      {
        name: "cuda"
        parameters { key: "gpu_mem_limit" value: "30064771072" }
        parameters { key: "cudnn_conv_use_max_workspace" value: "0" }
        parameters { key: "arena_extend_strategy" value: "kSameAsRequested" }
      }
    ]
  }
}

